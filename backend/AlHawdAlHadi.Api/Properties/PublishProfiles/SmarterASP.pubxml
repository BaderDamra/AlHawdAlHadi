<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <WebPublishMethod>MSDeploy</WebPublishMethod>
    <PublishProvider>IIS</PublishProvider>
    <_TargetId>IISWebDeploy</_TargetId>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <TargetFramework>net10.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <SiteUrlToLaunchAfterPublish>https://alhawd-001-site1.itempurl.com/</SiteUrlToLaunchAfterPublish>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <MSDeployServiceURL>https://win8072.site4now.net:8172/MsDeploy.axd?site=alhawd-001-site1</MSDeployServiceURL>
    <DeployIisAppPath>alhawd-001-site1</DeployIisAppPath>
    <MSDeployPublishMethod>WMSVC</MSDeployPublishMethod>
    <AuthType>Basic</AuthType>
    <UserName>alhawd-001</UserName>
    <_SavePWD>false</_SavePWD>
    <AllowUntrustedCertificate>false</AllowUntrustedCertificate>
    <SkipExtraFilesOnServer>true</SkipExtraFilesOnServer>
    <IncludeSetAclProviderOnDestination>false</IncludeSetAclProviderOnDestination>
    <EnableMSDeployAppOffline>true</EnableMSDeployAppOffline>
    <SmarterAspProductionSettings>$(MSBuildProjectDirectory)\..\..\deployment-secrets\appsettings.SmarterASP.json</SmarterAspProductionSettings>
  </PropertyGroup>

  <!-- Keep SQL/admin settings out of source control. Fail before deployment if
       the local production settings are unavailable rather than deploying LocalDB. -->
  <Target Name="PrepareSmarterAspPublishFiles" AfterTargets="ComputeFilesToPublish">
    <Error Condition="!Exists('$(SmarterAspProductionSettings)')"
           Text="SmarterASP production settings are missing. Restore deployment-secrets/appsettings.SmarterASP.json, or run deploy/Publish-SmarterAsp.ps1 with the production ConnectionFile first." />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Production.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'appsettings.Development.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SeedData\default-bookings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SeedData\runtime-cms.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SeedData\default-cms.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SeedData/default-bookings.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SeedData/runtime-cms.json' Or '%(ResolvedFileToPublish.RelativePath)' == 'SeedData/default-cms.json'" />
      <ResolvedFileToPublish Include="$(SmarterAspProductionSettings)">
        <RelativePath>appsettings.Production.json</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\SeedData\runtime-cms.json">
        <RelativePath>SeedData\default-cms.json</RelativePath>
        <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
